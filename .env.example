# NETRA AI — Environment Variables Example
# Copy this file to .env.local for frontend and .env for backend
# NEVER commit actual values to version control
# Use Zoho Catalyst Environment Variables for production secrets

# =============================================================
# FRONTEND (apps/frontend/.env.local)
# =============================================================

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Map Configuration
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_key_here

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key_here

# Feature Flags
NEXT_PUBLIC_ENABLE_VOICE=true
NEXT_PUBLIC_ENABLE_DIGITAL_TWIN=false

# =============================================================
# BACKEND (apps/backend/.env)
# =============================================================

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# Application
APP_NAME=NETRA AI Backend
APP_VERSION=0.1.0
SECRET_KEY=change-this-to-a-random-64-char-string-in-production

# JWT Configuration
JWT_PRIVATE_KEY_BASE64=your_rsa_private_key_base64_encoded
JWT_PUBLIC_KEY_BASE64=your_rsa_public_key_base64_encoded
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_HOURS=24
MAX_SESSION_HOURS=8

# Database (Zoho Catalyst Data Store)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/netra_ai
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Neo4j (Graph Database)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Redis (Zoho Catalyst Cache)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-pro
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.1

# OpenAI Whisper (Voice transcription)
OPENAI_API_KEY=your_openai_api_key

# Field Encryption Key (Fernet)
FIELD_ENCRYPTION_KEY=your_fernet_key_here

# Zoho Catalyst Configuration
CATALYST_PROJECT_ID=your_catalyst_project_id
CATALYST_AUTH_DOMAIN=your_domain.catalyst.zoho.com
CATALYST_FILE_STORE_ID=your_file_store_id

# CORS
CORS_ORIGINS=http://localhost:3000,https://netra-ai.catalyst.zoho.com

# Rate Limiting
RATE_LIMIT_DEFAULT=200
RATE_LIMIT_AI_ENDPOINT=20

# MFA
MFA_ISSUER=Karnataka State Police NETRA AI
MFA_ENABLED=true
MFA_REQUIRED_ROLES=INSPECTOR,DYSP,COMMISSIONER,SUPERADMIN

# Monitoring
SENTRY_DSN=your_sentry_dsn_optional

# =============================================================
# AI SERVICE (apps/ai/.env)
# =============================================================

GEMINI_API_KEY=your_gemini_api_key
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_key_optional
VECTOR_STORE_URL=your_vector_store_url
EMBEDDING_MODEL=text-embedding-004

# =============================================================
# ML SERVICE (apps/ml/.env)
# =============================================================

MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_REGISTRY_PATH=./models/registry
HOTSPOT_MODEL_VERSION=latest
RISK_MODEL_VERSION=latest
