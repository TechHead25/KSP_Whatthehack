{
  "name": "netra-api",
  "type": "app",
  "stack": "python3.11",
  "build": {
    "command": "pip install -r requirements.txt"
  },
  "run": {
    "command": "uvicorn main:app --host 0.0.0.0 --port $X_ZOHO_CATALYST_LISTEN_PORT"
  },
  "env": {
    "PYTHONUNBUFFERED": "1",
    "ENVIRONMENT": "production"
  }
}
